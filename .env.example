# Copy to $HOME/.tracker-env and chmod 600. Sourced by cron/systemd (never committed).
# Only fill what you use — every channel is optional and fails gracefully when empty.

# --- instant alerts (pick any; all $0) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
MATCH_WEBHOOK_URL=

# --- free SMTP email (e.g. Gmail App Password / Outlook) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- official Meta APIs (all $0; need App Review — see meta-app-review/) ---
META_IG_TOKEN=
META_IG_USER_ID=
META_FB_PAGE_TOKEN=
META_FB_PAGE_ID=
THREADS_TOKEN=
THREADS_USER_ID=

# --- crisis posture without editing config ---
# TRACKER_CRISIS=1
