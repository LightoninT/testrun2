# Copy to $HOME/.tracker-env and chmod 600. Sourced by cron/systemd (never committed).
# Dashboard-only alerting: no notification secrets exist. Meta tokens below only
# enable comment bodies + owned mentions; empty = gracefully skipped.

# --- official Meta APIs (all $0; need App Review — see meta-app-review/) ---
META_IG_TOKEN=
META_IG_USER_ID=
META_FB_PAGE_TOKEN=
META_FB_PAGE_ID=
THREADS_TOKEN=
THREADS_USER_ID=

# --- crisis posture without editing config ---
# TRACKER_CRISIS=1
